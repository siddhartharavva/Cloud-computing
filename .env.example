# ── Frontend (Vite) ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_DOMAIN=https://zerotrust-exchange.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
VITE_DEMO_MODE=true

# ── AWS Core ─────────────────────────────────────────────────────
AWS_REGION=ap-south-1
S3_BUCKET_NAME=zerotrustx-secure-storage
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=

# ── DynamoDB ─────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=ZeroTrustFiles

# ── KMS ──────────────────────────────────────────────────────────
KMS_KEY_ID=alias/zt-file-exchange

# ── Cognito (backend JWT validation) ─────────────────────────────
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXX
COGNITO_APP_CLIENT_ID=your-cognito-app-client-id
COGNITO_REGION=ap-south-1

# ── SNS ──────────────────────────────────────────────────────────
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:ZeroTrustAlerts

# ── SQS ──────────────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/ZeroTrustEvents

# ── CloudWatch ───────────────────────────────────────────────────
CLOUDWATCH_LOG_GROUP=/zerotrust/backend

# ── Secrets Manager ──────────────────────────────────────────────
SECRETS_MANAGER_SECRET_ID=zerotrust/config
